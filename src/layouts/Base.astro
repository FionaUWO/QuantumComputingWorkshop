---
import '../styles/site.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'lectures' | 'playground';
}
const { title, description, current } = Astro.props;
const home = current === 'home';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<link rel="icon" type="image/png" href={url('assets/img/lab-logo.png')}>
<script is:inline>document.documentElement.classList.add('js');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<header class="site-head">
  <div class="wrap">
    <a class="logo" href={url()}><img src={url('assets/img/lab-logo.png')} alt="" width="38" height="38">Quantum Workshop</a>
    {home ? (
      <nav class="site-nav" aria-label="Site">
        <a href="#parts">Outline</a>
        <a href="#lectures">Lectures</a>
        <a href={url('playground/')}>Playground</a>
        <a href="#lab">About us</a>
        <a href="#contact">Contact</a>
      </nav>
    ) : (
      <Fragment>
        <nav class="site-nav" aria-label="Site">
          <a href={url()}>Home</a>
          <a href={url('#lectures')} aria-current={current === 'lectures' ? 'page' : undefined}>Lectures</a>
          <a href={url('playground/')} aria-current={current === 'playground' ? 'page' : undefined}>Playground</a>
        </nav>
        <span class="head-note">Q-AICON Lab, Western University</span>
      </Fragment>
    )}
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site-foot">
  <div class="wrap">
    <div>
      <p class="foot-label">Q-AICON Lab</p>
      <p class="foot-name">Quantum and AI for Computing, Optimization, and Networking</p>
      <p>Western University</p>
    </div>
    <div>
      <p class="foot-label">Contact</p>
      <address>
        Dr. Fang (Fiona) Fang<br>
        Department of Electrical and Computer Engineering<br>
        Thompson Engineering Building, Room TEB 261<br>
        Western University<br>
        1151 Richmond St, London, ON N6A 3K7<br>
        <a href="mailto:fang.fang@uwo.ca">fang.fang@uwo.ca</a>
      </address>
    </div>
    <nav aria-label="Footer">
      <p class="foot-label">Explore</p>
      <a href={home ? '#lectures' : url('#lectures')}>Lectures</a>
      <a href={url('playground/')}>Playground</a>
      <a href="https://fionauwo.github.io/QAICON/">Lab website</a>
    </nav>
  </div>
</footer>

</body>
</html>
