---
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board.astro';
import { lectures } from '../../data/lectures';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await getCollection('lectures');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, ready: entries.map((e) => e.id) } }));
}

const { entry, ready } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const info = lectures.find((l) => l.num === d.num);
const next = lectures.find((l) => l.num === d.num + 1);
const nextReady = next && ready.includes(next.slug);
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---
<Base title={`Lecture ${d.num}: ${d.short} | Quantum Computing Workshop`} description={d.lede} current="lectures">
  <div class="page-hero"><div class="wrap">
    <p class="kicker">{info?.part}, lecture {d.num} of {lectures.length}</p>
    <h1 class="grad">{d.heading}</h1>
    <p class="lede">{d.lede}</p>
    <nav class="toc" aria-label="In this lecture">
      <ol>
        {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </nav>
  </div></div>

  <div class="wrap lecture-grid">
    <aside class="board-col" aria-label={d.boardLabel}>
      <Board kind={d.board} main />
    </aside>

    <article class="notes">
      <Content />

      {next && (
        <p class="next">
          Next: {nextReady
            ? <a href={url(`lectures/${next.slug}/`)}>Lecture {next.num}, <Fragment set:html={lower(next.title)} /></a>
            : <Fragment>lecture {next.num}, <Fragment set:html={lower(next.title)} /></Fragment>}.{' '}
          {d.nextNote}{' '}
          {!nextReady && <a href={url('#lectures')}>Back to all lectures</a>}
        </p>
      )}
    </article>
  </div>
</Base>
