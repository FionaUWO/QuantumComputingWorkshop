---
// Left-hand menu of the course pages: every lecture, its sections, and the
// subsections of the page being read. Pages already opened get a tick.
import type { Lecture } from '../lib/course';

interface Props {
  course: Lecture[];
  lecture: string;                              // slug of the lecture being read
  section?: string;                             // slug of the section being read, if any
  subsections?: { slug: string; text: string }[];
}
const { course, lecture, section, subsections = [] } = Astro.props;
---
<nav class="course-menu" id="course-menu" aria-label="Course contents">
  <p class="menu-title">Contents</p>
  {course.map((l) => l.sections.length === 0 ? (
    <p class="menu-lecture waiting"><span class="n">{l.num}</span><span set:html={l.title} /><small>In preparation</small></p>
  ) : (
    <details class="menu-lecture" open={l.slug === lecture}>
      <summary><span class="n">{l.num}</span><span set:html={l.title} /></summary>
      <ul>
        <li><a href={l.href} aria-current={l.slug === lecture && !section ? 'page' : undefined}>Overview</a></li>
        {l.sections.map((s) => {
          const here = l.slug === lecture && s.slug === section;
          return (
            <li>
              <a href={s.href} aria-current={here ? 'page' : undefined}><span class="num">{l.num}.{s.num}</span> {s.title}</a>
              {here && subsections.length > 0 && (
                <ul class="menu-sub">
                  {subsections.map((h, k) => <li><a href={`#${h.slug}`}><span class="num">{l.num}.{s.num}.{k + 1}</span> {h.text}</a></li>)}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </details>
  ))}
</nav>

<script>
  // Remember which pages this visitor has opened and tick them in the menu.
  const KEY = 'qcw-visited';
  let seen: string[] = [];
  try { seen = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { /* storage unavailable */ }
  const here = location.pathname;
  if (!seen.includes(here)) {
    seen.push(here);
    try { localStorage.setItem(KEY, JSON.stringify(seen)); } catch { /* storage unavailable */ }
  }
  document.querySelectorAll<HTMLAnchorElement>('.course-menu details > ul > li > a').forEach((a) => {
    if (seen.includes(new URL(a.href).pathname)) a.classList.add('seen');
  });

  // Opening and closing a lecture slides its list instead of snapping.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLDetailsElement>('details.menu-lecture').forEach((d) => {
    const list = d.querySelector<HTMLElement>(':scope > ul');
    const summary = d.querySelector('summary');
    if (!list || !summary || calm || !list.animate) return;
    let running: Animation | null = null;
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      running?.cancel();
      const closing = d.open && !d.classList.contains('closing');
      d.classList.toggle('closing', closing);
      if (!closing) d.open = true;
      const full = { height: list.scrollHeight + 'px', paddingBottom: getComputedStyle(list).paddingBottom, opacity: 1 };
      const shut = { height: '0px', paddingBottom: '0px', opacity: 0 };
      list.style.overflow = 'hidden';
      running = list.animate(closing ? [full, shut] : [shut, full], { duration: 260, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' });
      running.onfinish = () => {
        if (closing) d.open = false;
        d.classList.remove('closing');
        list.style.overflow = '';
        running = null;
      };
      // If the browser is not painting (a background tab), do not leave the list half open.
      const mine = running;
      setTimeout(() => { if (running === mine) mine.finish(); }, 400);
    });
  });

  // On narrow screens the menu is a drawer opened from the bar above the page.
  const shell = document.querySelector('.course-shell');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = shell!.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.querySelector('.menu-scrim')?.addEventListener('click', () => {
    shell!.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
  });
</script>
