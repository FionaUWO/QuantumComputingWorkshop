---
// The Trotter formula as a circuit. Time runs left to right, so in each step the factor
// e^{-iBt/m} (rightmost in the product e^{-iAt/m} e^{-iBt/m}) is applied first.
const yTop = 42, yBot = 142, bw = 64, bh = 40, gap = 8;
const pairX = [40, 192, 416];              // left edge of each drawn step
const pairW = 2 * bw + gap;                // 136
const dotsX = (pairX[1] + pairW + pairX[2]) / 2;
const x0 = 16, x1 = 584;
const big = { x: 205, w: 190 };
---
<svg viewBox="0 0 600 212" role="img" aria-label="Evolution under A plus B for time t is approximated by m short steps, each an evolution under B followed by an evolution under A for time t over m">
  <line class="f-wire" x1={x0} y1={yTop} x2={x1} y2={yTop} />
  <rect class="f-box" x={big.x} y={yTop - 22} width={big.w} height="44" rx="6" />
  <text class="f-label" x={big.x + big.w / 2} y={yTop + 7} text-anchor="middle">e<tspan dy="-7" font-size="11">−i(A+B)t</tspan></text>

  <text x="300" y="99" text-anchor="middle" style="font-size:22px">≈</text>

  <line class="f-wire" x1={x0} y1={yBot} x2={x1} y2={yBot} />
  <rect class="ts-mask" x={dotsX - 22} y={yBot - 6} width="44" height="12" />
  <text class="f-label" x={dotsX} y={yBot + 5} text-anchor="middle">· · ·</text>
  {pairX.map((x) => (
    <g>
      <rect class="f-box" x={x} y={yBot - bh / 2} width={bw} height={bh} rx="6" />
      <text class="f-label" x={x + bw / 2} y={yBot + 7} text-anchor="middle">e<tspan dy="-7" font-size="11">−iBt/m</tspan></text>
      <rect class="f-blob" x={x + bw + gap} y={yBot - bh / 2} width={bw} height={bh} rx="6" />
      <text class="f-label" x={x + bw + gap + bw / 2} y={yBot + 7} text-anchor="middle">e<tspan dy="-7" font-size="11">−iAt/m</tspan></text>
    </g>
  ))}

  <path class="f-thin" d={`M${pairX[0]} ${yBot + 30} v8 H${pairX[2] + pairW} v-8`} />
  <text class="f-note" x={(pairX[0] + pairX[2] + pairW) / 2} y={yBot + 58} text-anchor="middle">m steps, each of duration t/m</text>
</svg>

<style>
  .ts-mask { fill: var(--paper); }
</style>
