---
// A diagonal Hamiltonian is a cost function on bit strings. Example on three qubits:
// H = Z1 + Z1 Z2 + Z2 Z3, so E(z) = (-1)^z1 + (-1)^(z1+z2) + (-1)^(z2+z3).
// The eight energies are 3, 1, -1, 1, -1, -3, -1, 1; the minimum is at z = 101.
const n = 3;
const strings = Array.from({ length: 1 << n }, (_, k) => k.toString(2).padStart(n, '0'));
const s = (z: string, j: number) => (z[j - 1] === '1' ? -1 : 1);
const E = (z: string) => s(z, 1) + s(z, 1) * s(z, 2) + s(z, 2) * s(z, 3);
const energies = strings.map(E);
const Emin = Math.min(...energies);
const px = (i: number) => 96 + i * 48;
const py = (v: number) => 136 - v * 30;
const yt = [-3, -1, 1, 3];
const xL = 60, xR = px(7) + 24;
---
<svg viewBox="0 0 480 268" role="img" aria-label="The energy of each of the eight bit strings for a three qubit Ising Hamiltonian, with the lowest energy at the string 101">
  <line class="f-axis" x1={xL} y1={py(-3.5)} x2={xL} y2={py(3.5)} />
  <line class="f-axis" x1={xL} y1={py(0)} x2={xR} y2={py(0)} />
  <g class="f-note">
    {yt.map((v) => (
      <g>
        <line class="f-axis" x1={xL - 5} y1={py(v)} x2={xL} y2={py(v)} />
        <text x={xL - 10} y={py(v) + 4} text-anchor="end">{v < 0 ? `−${-v}` : v}</text>
      </g>
    ))}
    <text transform={`translate(18 ${py(0)}) rotate(-90)`} text-anchor="middle">E(z)</text>
    <text x={px(5) + 13} y={py(Emin) + 5}>lowest energy</text>
  </g>
  <text class="f-label" x={xR} y="24" text-anchor="end">H = Z₁ + Z₁Z₂ + Z₂Z₃</text>

  {strings.map((z, i) => (
    <g>
      <line class={energies[i] === Emin ? 'f-hot' : 'f-grid'} x1={px(i)} y1={py(0)} x2={px(i)} y2={py(energies[i])} />
      <circle class={energies[i] === Emin ? 'f-syn' : 'f-z'} cx={px(i)} cy={py(energies[i])} r="6" />
      <text class={energies[i] === Emin ? 'f-label f-strong' : 'f-label'} x={px(i)} y="262" text-anchor="middle">{z}</text>
    </g>
  ))}
</svg>
