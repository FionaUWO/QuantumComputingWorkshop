---
// Two Hadamards applied to |0>, drawn as paths. Each edge carries an entry of H. The two paths
// into |0> have amplitude 1/2 each and add; the two paths into |1> have 1/2 and -1/2 and cancel.
const top = 70, bot = 180, mid = 125;
const bw = 56, bh = 34;
const x0 = 22, x1 = 222, x2 = 422;     // left edges of the three columns of boxes
---
<svg viewBox="0 0 600 215" role="img" aria-label="The four paths through two Hadamard gates: two add up at outcome zero and two cancel at outcome one">
  <defs>
    <marker id="interferencepaths-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>
  <g class="f-note" text-anchor="middle">
    <text x="150" y="16">first H</text>
    <text x="350" y="16">second H</text>
    <text x="530" y="16">add the paths</text>
  </g>

  <line class="f-flow" x1={x0 + bw} y1={mid} x2={x1 - 2} y2={top} marker-end="url(#interferencepaths-arrow)" />
  <line class="f-flow" x1={x0 + bw} y1={mid} x2={x1 - 2} y2={bot} marker-end="url(#interferencepaths-arrow)" />
  <text class="f-label" x="140" y="88" text-anchor="middle">1/√2</text>
  <text class="f-label" x="140" y="176" text-anchor="middle">1/√2</text>

  <line class="f-flow" x1={x1 + bw} y1={top} x2={x2 - 2} y2={top} marker-end="url(#interferencepaths-arrow)" />
  <line class="f-flow" x1={x1 + bw} y1={top} x2={x2 - 2} y2={bot} marker-end="url(#interferencepaths-arrow)" />
  <line class="f-flow" x1={x1 + bw} y1={bot} x2={x2 - 2} y2={top} marker-end="url(#interferencepaths-arrow)" />
  <line class="f-hot" x1={x1 + bw} y1={bot} x2={x2 - 4} y2={bot} marker-end="url(#interferencepaths-arrow)" />
  <text class="f-label" x="350" y={top - 9} text-anchor="middle">1/√2</text>
  <text class="f-label" x="330" y="98">1/√2</text>
  <text class="f-label" x="330" y="163">1/√2</text>
  <text class="f-label f-strong" x="350" y={bot + 22} text-anchor="middle">−1/√2</text>

  <rect class="f-box" x={x0} y={mid - bh / 2} width={bw} height={bh} rx="6" />
  <text class="f-label" x={x0 + bw / 2} y={mid + 5} text-anchor="middle">|0⟩</text>
  <rect class="f-box" x={x1} y={top - bh / 2} width={bw} height={bh} rx="6" />
  <text class="f-label" x={x1 + bw / 2} y={top + 5} text-anchor="middle">|0⟩</text>
  <rect class="f-box" x={x1} y={bot - bh / 2} width={bw} height={bh} rx="6" />
  <text class="f-label" x={x1 + bw / 2} y={bot + 5} text-anchor="middle">|1⟩</text>
  <rect class="f-blob" x={x2} y={top - bh / 2} width={bw} height={bh} rx="6" />
  <text class="f-label" x={x2 + bw / 2} y={top + 5} text-anchor="middle">|0⟩</text>
  <rect class="f-quiet" x={x2} y={bot - bh / 2} width={bw} height={bh} rx="6" />
  <text class="f-label" x={x2 + bw / 2} y={bot + 5} text-anchor="middle">|1⟩</text>

  <text class="f-label f-strong" x={x2 + bw + 14} y={top + 5}>½ + ½ = 1</text>
  <text class="f-label f-strong" x={x2 + bw + 14} y={bot + 5}>½ − ½ = 0</text>
</svg>
