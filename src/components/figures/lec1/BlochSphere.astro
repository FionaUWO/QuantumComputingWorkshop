---
// The Bloch sphere: a state at polar angle theta and azimuth phi, and the six named states at
// the ends of the three axes. Orthographic view from azimuth 20 degrees, elevation 25 degrees.
const rad = Math.PI / 180;
const A = 20 * rad, E = 25 * rad, R = 120, cx = 220, cy = 170;
type V = [number, number, number];
const P = ([x, y, z]: V) => [
  cx + R * (-x * Math.sin(A) + y * Math.cos(A)),
  cy - R * (z * Math.cos(E) - (x * Math.cos(A) + y * Math.sin(A)) * Math.sin(E)),
];
const sph = (r: number, t: number, p: number): V => [r * Math.sin(t) * Math.cos(p), r * Math.sin(t) * Math.sin(p), r * Math.cos(t)];
const f = (n: number) => n.toFixed(1);
const path = (pts: V[]) => 'M' + pts.map((p) => P(p).map(f).join(' ')).join(' L');
const steps = (n: number) => Array.from({ length: n + 1 }, (_, i) => i / n);

const th = 60 * rad, ph = 75 * rad;                // the state that is drawn
const psi = P(sph(1, th, ph));
const foot = P(sph(Math.sin(th), Math.PI / 2, ph));
const O = P([0, 0, 0]);

// the equator: the half facing the viewer is solid, the far half is dashed
const eqFront = path(steps(40).map((s) => sph(1, Math.PI / 2, A - Math.PI / 2 + Math.PI * s)));
const eqBack = path(steps(40).map((s) => sph(1, Math.PI / 2, A + Math.PI / 2 + Math.PI * s)));
const thArc = path(steps(16).map((s) => sph(0.3, th * s, ph)));
const phArc = path(steps(16).map((s) => sph(0.32, Math.PI / 2, ph * s)));
const thLab = P(sph(0.45, th / 2, ph));
const phLab = P(sph(0.55, Math.PI / 2, ph / 2));

const xp = P([1, 0, 0]), xm = P([-1, 0, 0]), yp = P([0, 1, 0]), ym = P([0, -1, 0]), zp = P([0, 0, 1]), zm = P([0, 0, -1]);
const xe = P([1.3, 0, 0]), ye = P([0, 1.3, 0]), ze = P([0, 0, 1.3]);
---
<svg viewBox="0 0 400 320" role="img" aria-label="The Bloch sphere with the angles theta and phi of a state and the six states on the axes">
  <circle class="f-ring" cx={cx} cy={cy} r={R} />
  <path class="f-ghost" d={eqBack} />
  <path class="f-ring" d={eqFront} />

  {[xm, ym, zm].map((p) => <line class="f-ghost" x1={f(O[0])} y1={f(O[1])} x2={f(p[0])} y2={f(p[1])} />)}
  {[xe, ye, ze].map((p) => <line class="f-axis" x1={f(O[0])} y1={f(O[1])} x2={f(p[0])} y2={f(p[1])} />)}

  <line class="f-ghost" x1={f(O[0])} y1={f(O[1])} x2={f(foot[0])} y2={f(foot[1])} />
  <line class="f-ghost" x1={f(psi[0])} y1={f(psi[1])} x2={f(foot[0])} y2={f(foot[1])} />
  <path class="f-flow" d={thArc} />
  <path class="f-flow" d={phArc} />
  <text class="f-it" x={f(thLab[0] - 6)} y={f(thLab[1] - 1)} text-anchor="middle">θ</text>
  <text class="f-it" x={f(phLab[0])} y={f(phLab[1] + 5)} text-anchor="middle">φ</text>

  {[xm, ym, zm].map((p) => <circle class="f-target" cx={f(p[0])} cy={f(p[1])} r="4" />)}
  {[xp, yp, zp].map((p) => <circle class="f-dot" cx={f(p[0])} cy={f(p[1])} r="4.5" />)}

  <line class="f-hot" x1={f(O[0])} y1={f(O[1])} x2={f(psi[0])} y2={f(psi[1])} />
  <circle class="f-syn" cx={f(psi[0])} cy={f(psi[1])} r="6" />
  <text class="f-label f-strong" x={f(psi[0] + 4)} y={f(psi[1] - 13)} text-anchor="middle">|ψ⟩</text>

  <text class="f-label" x={f(zp[0] + 9)} y={f(zp[1] - 19)}>|0⟩</text>
  <text class="f-label" x={f(zm[0])} y={f(zm[1] + 29)} text-anchor="middle">|1⟩</text>
  <text class="f-label" x={f(xp[0] + 7)} y={f(xp[1] + 21)}>|+⟩</text>
  <text class="f-label" x={f(xm[0] + 8)} y={f(xm[1] - 3)}>|−⟩</text>
  <text class="f-label" x={f(yp[0] + 11)} y={f(yp[1] + 26)}>|+i⟩</text>
  <text class="f-label" x={f(ym[0] - 11)} y={f(ym[1] + 4)} text-anchor="end">|−i⟩</text>

  <g class="f-note">
    <text x={f(xe[0] - 6)} y={f(xe[1] + 12)} text-anchor="end">x</text>
    <text x={f(ye[0] + 6)} y={f(ye[1] + 5)}>y</text>
    <text x={f(ze[0] - 7)} y={f(ze[1] + 5)} text-anchor="end">z</text>
  </g>
</svg>
