---
// The running example (|0> + (1+i)|1>)/sqrt(3) measured in two bases: outcome probabilities
// 1/3, 2/3 in the computational basis and 5/6, 1/6 in the plus/minus basis.
const base = 195, full = 140;          // y of probability 0, and the height of probability 1
const py = (p: number) => +(base - full * p).toFixed(1);
const w = 46;
const panels = [
  { x0: 50, title: 'computational basis', bars: [{ out: '0', p: 1 / 3, val: '1/3' }, { out: '1', p: 2 / 3, val: '2/3' }] },
  { x0: 280, title: 'basis |+⟩, |−⟩', bars: [{ out: '+', p: 5 / 6, val: '5/6' }, { out: '−', p: 1 / 6, val: '1/6' }] },
];
---
<svg viewBox="0 0 480 250" role="img" aria-label="Outcome probabilities of the same state in the computational basis and in the plus minus basis">
  {panels.map(({ x0, title, bars }) => (
    <g>
      <line class="f-ghost" x1={x0} y1={py(1)} x2={x0 + 160} y2={py(1)} />
      <g class="f-note" text-anchor="end">
        <text x={x0 - 8} y={py(1) + 4}>1</text>
        <text x={x0 - 8} y={py(0) + 4}>0</text>
      </g>
      {bars.map(({ out, p, val }, i) => (
        <g>
          <rect class="f-blob" x={x0 + 25 + 64 * i} y={py(p)} width={w} height={(full * p).toFixed(1)} />
          <text class="f-label" x={x0 + 25 + 64 * i + w / 2} y={py(p) - 8} text-anchor="middle">{val}</text>
          <text class="f-label" x={x0 + 25 + 64 * i + w / 2} y={base + 20} text-anchor="middle">{out}</text>
        </g>
      ))}
      <line class="f-axis" x1={x0} y1={base} x2={x0 + 160} y2={base} />
      <text class="f-note" x={x0 + 80} y={base + 44} text-anchor="middle">{title}</text>
    </g>
  ))}
</svg>
