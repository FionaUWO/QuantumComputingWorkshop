---
// X exchanges |0> and |1>; Z exchanges |+> and |->. Drawn on the x-z circle of the Bloch sphere.
const R = 62, cy = 100;
const panels = [
  { cx: 130, vertical: true, name: 'X swaps |0⟩ and |1⟩' },
  { cx: 390, vertical: false, name: 'Z swaps |+⟩ and |−⟩' },
];
---
<svg viewBox="0 0 520 215" role="img" aria-label="X swaps the computational basis states and Z swaps the plus and minus states">
  <defs>
    <marker id="ps-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>
  {panels.map(({ cx, vertical, name }) => (
    <g>
      <circle class="f-ring" cx={cx} cy={cy} r={R} />
      {vertical
        ? <line class="f-hot" x1={cx} y1={cy - R + 12} x2={cx} y2={cy + R - 12} marker-start="url(#ps-arrow)" marker-end="url(#ps-arrow)" />
        : <line class="f-hot" x1={cx - R + 12} y1={cy} x2={cx + R - 12} y2={cy} marker-start="url(#ps-arrow)" marker-end="url(#ps-arrow)" />}
      <circle class="f-dot" cx={cx} cy={cy - R} r="5" />
      <circle class="f-dot" cx={cx} cy={cy + R} r="5" />
      <circle class="f-dot" cx={cx + R} cy={cy} r="5" />
      <circle class="f-dot" cx={cx - R} cy={cy} r="5" />
      <text class="f-label" x={cx} y={cy - R - 11} text-anchor="middle">|0⟩</text>
      <text class="f-label" x={cx} y={cy + R + 22} text-anchor="middle">|1⟩</text>
      <text class="f-label" x={cx + R + 11} y={cy + 5}>|+⟩</text>
      <text class="f-label" x={cx - R - 11} y={cy + 5} text-anchor="end">|−⟩</text>
      <text class="f-note" x={cx} y="210" text-anchor="middle">{name}</text>
    </g>
  ))}
</svg>
