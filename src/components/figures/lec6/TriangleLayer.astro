---
// One QAOA layer (p = 1) for the triangle graph: Hadamards, three edge gadgets, mixer rotations.
const q = [50, 100, 150];        // wires of qubits 1, 2, 3
const x0 = 172, x1 = 650;
const hx = 194;                  // Hadamards
// each edge (i, j): CNOT i -> j, Rz(-gamma) on j, CNOT i -> j. s is the left edge of the gadget.
const edges = [
  { c: 0, t: 1, s: 212, name: 'edge (1, 2)' },
  { c: 1, t: 2, s: 333, name: 'edge (2, 3)' },
  { c: 0, t: 2, s: 454, name: 'edge (1, 3)' },
];
const rx = 608;                  // centre of the mixer rotations
const v = [[58, 62], [24, 128], [92, 128]];   // the graph drawn on the left
const sides = [[0, 1], [1, 2], [0, 2]];
---
<svg viewBox="0 0 660 204" role="img" aria-label="One QAOA layer for the triangle graph: a Hadamard on each qubit, then for each edge a CNOT, a z rotation by minus gamma on the target and a second CNOT, then an x rotation by two beta on each qubit">
  <g>
    {sides.map(([a, b]) => <line class="f-thin" x1={v[a][0]} y1={v[a][1]} x2={v[b][0]} y2={v[b][1]} />)}
    {v.map(([x, y], i) => (
      <g>
        <circle class="f-z" cx={x} cy={y} r="12" />
        <text class="f-z-t" x={x} y={y + 4.5} text-anchor="middle">{i + 1}</text>
      </g>
    ))}
  </g>

  {q.map((y, i) => (
    <g>
      <text class="f-note" x="126" y={y + 4.5} text-anchor="middle">{i + 1}</text>
      <text class="f-label" x="166" y={y + 5} text-anchor="end">|0⟩</text>
      <line class="f-wire" x1={x0} y1={y} x2={x1} y2={y} />
      <rect class="f-box" x={hx - 14} y={y - 14} width="28" height="28" rx="4" />
      <text class="f-label" x={hx} y={y + 5} text-anchor="middle">H</text>
      <rect class="f-box" x={rx - 28} y={y - 14} width="56" height="28" rx="4" />
      <text class="f-label" x={rx} y={y + 5} text-anchor="middle">R<tspan dy="4" font-size="11">x</tspan><tspan dy="-4">(2β)</tspan></text>
    </g>
  ))}

  {edges.map(({ c, t, s, name }) => (
    <g>
      <text class="f-note" x={s + 60} y="18" text-anchor="middle">{name}</text>
      {[s + 14, s + 106].map((x) => (
        <g>
          <line class="f-wire" x1={x} y1={q[c]} x2={x} y2={q[t] + 9} />
          <circle class="f-dot" cx={x} cy={q[c]} r="4.5" />
          <circle class="f-target" cx={x} cy={q[t]} r="9" />
          <line class="f-wire" x1={x - 9} y1={q[t]} x2={x + 9} y2={q[t]} />
          <line class="f-wire" x1={x} y1={q[t] - 9} x2={x} y2={q[t] + 9} />
        </g>
      ))}
      <rect class="f-blob" x={s + 32} y={q[t] - 14} width="56" height="28" rx="4" />
      <text class="f-label" x={s + 60} y={q[t] + 5} text-anchor="middle">R<tspan dy="4" font-size="11">z</tspan><tspan dy="-4">(−γ)</tspan></text>
    </g>
  ))}

  <text class="f-note" x={rx} y="18" text-anchor="middle">mixer</text>
  <path class="f-axis" fill="none" d="M216 172 v6 H570 v-6" />
  <text class="f-label" x="393" y="198" text-anchor="middle">U<tspan dy="4" font-size="11">C</tspan><tspan dy="-4">(γ)</tspan></text>
  <path class="f-axis" fill="none" d={`M${rx - 28} 172 v6 H${rx + 28} v-6`} />
  <text class="f-label" x={rx} y="198" text-anchor="middle">U<tspan dy="4" font-size="11">B</tspan><tspan dy="-4">(β)</tspan></text>
</svg>
