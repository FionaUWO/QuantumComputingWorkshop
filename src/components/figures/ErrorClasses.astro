---
// The three kinds of Pauli error for a stabilizer code, as nested sets: S inside N(S) inside G_n.
---
<svg viewBox="0 0 520 262" role="img" aria-label="Errors in S do nothing, errors in N(S) outside S are logical errors, all others are detected">
  <rect class="f-cell" x="10" y="10" width="500" height="242" rx="14" />
  <text class="f-label f-strong" x="30" y="40">detected</text>
  <text class="f-note" x="30" y="58">anticommutes with at least one check</text>
  <text class="f-label f-it" x="490" y="40" text-anchor="end">G<tspan dy="4" font-size="11">n</tspan></text>

  <rect class="f-soft" x="70" y="78" width="380" height="152" rx="12" />
  <text class="f-label f-strong" x="90" y="106">logical error</text>
  <text class="f-note" x="90" y="124">commutes with every check, not in S</text>
  <text class="f-label f-it" x="432" y="106" text-anchor="end">N(S)</text>

  <rect class="f-blob" x="170" y="142" width="180" height="68" rx="10" />
  <text class="f-label f-strong" x="260" y="172" text-anchor="middle">no effect</text>
  <text class="f-note" x="260" y="192" text-anchor="middle">an element of S</text>
</svg>
