---
// The nine qubits of the Shor code in three blocks, with its six Z-type and two X-type checks.
const X = (i: number) => 50 + i * 56 + Math.floor(i / 3) * 28;
const y = 100, r = 15;
const zPairs = [0, 1, 3, 4, 6, 7];           // check on qubits i and i + 1
const xChecks = [
  { from: 0, to: 5, y: 62, name: 'X₁X₂X₃X₄X₅X₆' },
  { from: 3, to: 8, y: 30, name: 'X₄X₅X₆X₇X₈X₉' },
];
---
<svg viewBox="0 0 604 180" role="img" aria-label="The checks of the Shor code">
  {xChecks.map((c) => (
    <g>
      <path class="f-flow" stroke-width="2.5" d={`M${X(c.from) - r} ${c.y + 10} V${c.y} H${X(c.to) + r} V${c.y + 10}`} />
      <text class="f-note" x={(X(c.from) + X(c.to)) / 2} y={c.y - 7} text-anchor="middle">{c.name}</text>
    </g>
  ))}

  {zPairs.map((i) => (
    <g>
      <path class="f-thin" d={`M${X(i)} ${y + r} Q${(X(i) + X(i + 1)) / 2} ${y + r + 34} ${X(i + 1)} ${y + r}`} />
      <text class="f-note" x={(X(i) + X(i + 1)) / 2} y={y + r + 36} text-anchor="middle">ZZ</text>
    </g>
  ))}

  {Array.from({ length: 9 }, (_, i) => (
    <g>
      <circle class="f-box" cx={X(i)} cy={y} r={r} />
      <text class="f-label" x={X(i)} y={y + 5} text-anchor="middle">{i + 1}</text>
    </g>
  ))}
</svg>
