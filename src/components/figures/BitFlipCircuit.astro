---
// The three-qubit bit flip code as a circuit: encode, error, syndrome measurement, recovery.
const q = [44, 84, 124];   // data wires
const a = [184, 224];      // ancilla wires
const x0 = 78;             // where the wires start

// control wire y, target wire y, x position
const cnots = [
  [q[0], q[1], 118], [q[0], q[2], 148],   // encode
  [q[0], a[0], 300], [q[1], a[0], 330],   // Z1 Z2 onto the first ancilla
  [q[1], a[1], 380], [q[2], a[1], 410],   // Z2 Z3 onto the second ancilla
];
const meters = [[a[0], 556, 'Z₁Z₂'], [a[1], 578, 'Z₂Z₃']] as const;
const mx = 452;            // left edge of the meters
---
<svg viewBox="0 0 660 250" role="img" aria-label="Circuit of the three-qubit bit flip code">
  <g class="f-note">
    <text x="133" y="16" text-anchor="middle">encode</text>
    <text x="225" y="16" text-anchor="middle">error</text>
    <text x="355" y="16" text-anchor="middle">measure the syndrome</text>
    <text x="568" y="16" text-anchor="middle">recover</text>
  </g>

  <g class="f-label" text-anchor="end">
    <text x={x0 - 10} y={q[0] + 5}>|ψ⟩</text>
    <text x={x0 - 10} y={q[1] + 5}>|0⟩</text>
    <text x={x0 - 10} y={q[2] + 5}>|0⟩</text>
    <text x={x0 - 10} y={a[0] + 5}>|0⟩</text>
    <text x={x0 - 10} y={a[1] + 5}>|0⟩</text>
  </g>

  {q.map((y) => <line class="f-wire" x1={x0} y1={y} x2="640" y2={y} />)}
  {a.map((y) => <line class="f-wire" x1={x0} y1={y} x2={mx} y2={y} />)}

  {cnots.map(([c, t, x]) => (
    <g>
      <line class="f-wire" x1={x} y1={c} x2={x} y2={t + 9} />
      <circle class="f-dot" cx={x} cy={c} r="4.5" />
      <circle class="f-target" cx={x} cy={t} r="9" />
      <line class="f-wire" x1={x - 9} y1={t} x2={x + 9} y2={t} />
    </g>
  ))}

  <rect class="f-box f-dashed" x="198" y={q[0] - 20} width="54" height={q[2] - q[0] + 40} rx="6" />
  <text class="f-label" x="225" y={q[1] + 5} text-anchor="middle">E</text>

  {meters.map(([y, up, name]) => (
    <g>
      <path class="f-classical" d={`M${mx + 36} ${y - 1.5} H${up - 1.5} V${q[2] + 20}`} />
      <path class="f-classical" d={`M${mx + 36} ${y + 1.5} H${up + 1.5} V${q[2] + 20}`} />
      <rect class="f-box" x={mx} y={y - 14} width="36" height="28" rx="4" />
      <path class="f-wire" fill="none" d={`M${mx + 8} ${y + 7} a10 10 0 0 1 20 0`} />
      <line class="f-wire" x1={mx + 18} y1={y + 7} x2={mx + 27} y2={y - 8} />
      <text class="f-label" x="596" y={y + 5}>{name}</text>
    </g>
  ))}

  <rect class="f-box" x="540" y={q[0] - 20} width="56" height={q[2] - q[0] + 40} rx="6" />
  <text class="f-label" x="568" y={q[1] + 5} text-anchor="middle">R</text>
</svg>
