---
// Phase kickback: with the answer qubit in |->, U_f leaves it alone and puts the sign (-1)^f(x) on the input.
const top = 50, bot = 120, mid = (top + bot) / 2;
---
<svg viewBox="0 0 540 170" role="img" aria-label="Phase kickback: the oracle acting on x and the minus state returns a sign on x and leaves the minus state unchanged">
  <defs>
    <marker id="kickback-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>
  <g class="f-label" text-anchor="end">
    <text x="100" y={top + 5}>|x⟩</text>
    <text x="100" y={bot + 5}>|−⟩</text>
  </g>
  <line class="f-wire" x1="108" y1={top} x2="340" y2={top} />
  <line class="f-wire" x1="108" y1={bot} x2="340" y2={bot} />
  <rect class="f-box" x="190" y={top - 24} width="80" height={bot - top + 48} rx="6" />
  <text class="f-label" x="230" y={mid + 5} text-anchor="middle">U<tspan dy="4" font-size="11">f</tspan></text>
  <g class="f-label">
    <text x="348" y={top + 5}>(−1)<tspan dy="-7" font-size="11">f(x)</tspan><tspan dy="7"> |x⟩</tspan></text>
    <text x="348" y={bot + 5}>|−⟩</text>
  </g>
  <path class="f-flow" d={`M372 ${bot - 14} Q386 ${mid + 2} 374 ${top + 18}`} marker-end="url(#kickback-arrow)" />
  <g class="f-note">
    <text x="396" y={mid - 1}>f(x) becomes a sign</text>
    <text x="396" y={mid + 15}>on the input register</text>
  </g>
</svg>
