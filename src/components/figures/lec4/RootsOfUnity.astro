---
// The eight 8th roots of unity as arrows from the origin, and the same arrows laid head to
// tail: they close up into a regular octagon, so their sum is zero.
const N = 8;
const names = ['1', 'ω', 'ω²', 'ω³', 'ω⁴', 'ω⁵', 'ω⁶', 'ω⁷'];
const ang = (k: number) => (2 * Math.PI * k) / N;
const f = (v: number) => v.toFixed(1);

// left panel: unit circle
const cx = 140, cy = 155, R = 88, RL = 110;
const roots = names.map((name, k) => ({
  name,
  x: cx + R * Math.cos(ang(k)), y: cy - R * Math.sin(ang(k)),
  lx: cx + RL * Math.cos(ang(k)), ly: cy - RL * Math.sin(ang(k)) + 5,
}));

// right panel: the same eight arrows, each starting where the previous one ends
const ox = 420, oy = 155, s = 66;
const apothem = s / (2 * Math.tan(Math.PI / N));
let px = ox - s / 2, py = oy + apothem;
const start = { x: px, y: py };
const steps = names.map((name, k) => {
  const x1 = px, y1 = py;
  px += s * Math.cos(ang(k));
  py -= s * Math.sin(ang(k));
  // label outside the octagon, opposite the middle of the edge
  const out = ang(k) - Math.PI / 2;
  return {
    name, x1, y1, x2: px, y2: py,
    lx: ox + (apothem + 15) * Math.cos(out), ly: oy - (apothem + 15) * Math.sin(out) + 5,
  };
});
---
<svg viewBox="0 0 560 290" role="img" aria-label="The eight 8th roots of unity on the unit circle, and the same eight arrows placed head to tail closing into an octagon">
  <defs>
    <marker id="rootsofunity-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  <g class="f-note" text-anchor="middle">
    <text x={cx} y="14">the powers of ω for N = 8</text>
    <text x={ox} y="14">the same arrows, head to tail</text>
  </g>

  <circle class="f-ring" cx={cx} cy={cy} r={R} />
  {roots.map((r) => (
    <g>
      <line class="f-flow" x1={cx} y1={cy} x2={f(r.x)} y2={f(r.y)} marker-end="url(#rootsofunity-arrow)" />
      <text class="f-label" x={f(r.lx)} y={f(r.ly)} text-anchor="middle">{r.name}</text>
    </g>
  ))}
  <circle class="f-dot" cx={cx} cy={cy} r="3" />

  {steps.map((e) => (
    <g>
      <line class="f-flow" x1={f(e.x1)} y1={f(e.y1)} x2={f(e.x2)} y2={f(e.y2)} marker-end="url(#rootsofunity-arrow)" />
      <text class="f-label" x={f(e.lx)} y={f(e.ly)} text-anchor="middle">{e.name}</text>
    </g>
  ))}
  <circle class="f-dot" cx={f(start.x)} cy={f(start.y)} r="3" />
  <text class="f-label" x={ox} y={oy + 5} text-anchor="middle">sum = 0</text>
</svg>
