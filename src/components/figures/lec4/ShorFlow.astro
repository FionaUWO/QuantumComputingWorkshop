---
// The loop of Shor's algorithm (steps 2 to 4), with the example N = 15, x = 7 written below.
const top = 60, h = 50, mid = top + h / 2, bot = top + h;
const b1 = { x: 10, w: 90 }, b2 = { x: 130, w: 140 }, b3 = { x: 300, w: 140 }, b4 = { x: 486, w: 154 };
const cxOf = (b: { x: number; w: number }) => b.x + b.w / 2;
const back = 24;                  // height of the return path
---
<svg viewBox="0 0 650 175" role="img" aria-label="Flow of Shor's algorithm: choose x, find its order r, test r, take greatest common divisors, or go back and choose another x">
  <defs>
    <marker id="shorflow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  <line class="f-flow" x1={b1.x + b1.w + 2} y1={mid} x2={b2.x - 3} y2={mid} marker-end="url(#shorflow-arrow)" />
  <line class="f-flow" x1={b2.x + b2.w + 2} y1={mid} x2={b3.x - 3} y2={mid} marker-end="url(#shorflow-arrow)" />
  <line class="f-flow" x1={b3.x + b3.w + 2} y1={mid} x2={b4.x - 3} y2={mid} marker-end="url(#shorflow-arrow)" />
  <path class="f-flow" d={`M${cxOf(b3)} ${top - 2} V${back} H${cxOf(b1)} V${top - 3}`} marker-end="url(#shorflow-arrow)" />

  <g class="f-note">
    <text x={(cxOf(b1) + cxOf(b3)) / 2} y={back - 8} text-anchor="middle">otherwise choose another x</text>
    <text x={cxOf(b3) + 8} y={top - 12}>no</text>
    <text x={(b3.x + b3.w + b4.x) / 2} y={mid - 8} text-anchor="middle">yes</text>
  </g>

  <rect class="f-cell" x={b1.x} y={top} width={b1.w} height={h} rx="6" />
  <text class="f-label" x={cxOf(b1)} y={mid + 5} text-anchor="middle">choose x</text>

  <rect class="f-blob" x={b2.x} y={top} width={b2.w} height={h} rx="6" />
  <text class="f-label" x={cxOf(b2)} y={mid + 5} text-anchor="middle">find the order r</text>

  <rect class="f-cell" x={b3.x} y={top} width={b3.w} height={h} rx="6" />
  <text class="f-label" x={cxOf(b3)} y={mid - 4} text-anchor="middle">r even and</text>
  <text class="f-label" x={cxOf(b3)} y={mid + 17} text-anchor="middle">x<tspan dy="-6" style="font-size:11px">r/2</tspan><tspan dy="6"> ≢ −1 ?</tspan></text>

  <rect class="f-cell" x={b4.x} y={top} width={b4.w} height={h} rx="6" />
  <text class="f-label" x={cxOf(b4)} y={mid + 5} text-anchor="middle">gcd(x<tspan dy="-6" style="font-size:11px">r/2</tspan><tspan dy="6"> ± 1, N)</tspan></text>

  <g class="f-note" text-anchor="middle">
    <text x={cxOf(b1)} y={bot + 20}>x = 7</text>
    <text x={cxOf(b2)} y={bot + 20}>r = 4</text>
    <text x={cxOf(b2)} y={bot + 38}>the quantum step</text>
    <text x={cxOf(b3)} y={bot + 20}>7² ≡ 4 mod 15</text>
    <text x={cxOf(b4)} y={bot + 20}>gcd(3, 15) = 3</text>
    <text x={cxOf(b4)} y={bot + 38}>gcd(5, 15) = 5</text>
  </g>
</svg>
