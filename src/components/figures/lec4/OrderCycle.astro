---
// Multiplication by 7 modulo 15 moves the powers of 7 round a cycle of length r = 4.
// Beside each power is its amplitude in |u_1> (up to the factor 1/2): c_k = exp(-2 pi i k / 4).
const cx = 210, cy = 150, R = 85, nr = 20;
const rad = (deg: number) => (deg * Math.PI) / 180;
// angle measured clockwise from the top of the ring
const at = (deg: number, rr = R) => [cx + rr * Math.sin(rad(deg)), cy - rr * Math.cos(rad(deg))];
const f = (v: number) => v.toFixed(1);

const nodes = [
  { v: '1', c: 'c₀ = 1' },
  { v: '7', c: 'c₁ = −i' },
  { v: '4', c: 'c₂ = −1' },
  { v: '13', c: 'c₃ = i' },
].map((n, k) => ({ ...n, x: at(90 * k)[0], y: at(90 * k)[1] }));

const arcs = nodes.map((_, k) => {
  const [ax, ay] = at(90 * k + 19);
  const [bx, by] = at(90 * k + 69);
  return `M${f(ax)} ${f(ay)} A${R} ${R} 0 0 1 ${f(bx)} ${f(by)}`;
});
---
<svg viewBox="0 0 420 285" role="img" aria-label="Multiplication by 7 modulo 15 sends 1 to 7 to 4 to 13 and back to 1, a cycle of length 4">
  <defs>
    <marker id="ordercycle-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  {arcs.map((d) => <path class="f-flow" d={d} marker-end="url(#ordercycle-arrow)" />)}

  {nodes.map((n) => (
    <g>
      <circle class="f-blob" cx={f(n.x)} cy={f(n.y)} r={nr} />
      <text class="f-label f-strong" x={f(n.x)} y={f(n.y + 5)} text-anchor="middle">{n.v}</text>
    </g>
  ))}

  <text class="f-label" x={cx} y={cy - 4} text-anchor="middle">× 7 mod 15</text>
  <text class="f-note" x={cx} y={cy + 18} text-anchor="middle">order r = 4</text>

  <g class="f-label">
    <text x={cx} y={cy - R - nr - 9} text-anchor="middle">{nodes[0].c}</text>
    <text x={cx + R + nr + 8} y={cy + 5}>{nodes[1].c}</text>
    <text x={cx} y={cy + R + nr + 20} text-anchor="middle">{nodes[2].c}</text>
    <text x={cx - R - nr - 8} y={cy + 5} text-anchor="end">{nodes[3].c}</text>
  </g>
</svg>
