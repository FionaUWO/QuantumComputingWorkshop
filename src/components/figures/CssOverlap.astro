---
// An X-type and a Z-type check of the Steane code. They overlap on two qubits, so they commute.
const X = (i: number) => 168 + i * 48;
const rows = [
  { y: 62, kind: 'x', on: [1, 3, 5, 7], name: 'X-type check' },
  { y: 118, kind: 'z', on: [2, 3, 6, 7], name: 'Z-type check' },
];
const both = [3, 7];
---
<svg viewBox="0 0 500 172" role="img" aria-label="An X-type check and a Z-type check overlapping on two qubits">
  {both.map((q) => <rect class="f-face" x={X(q - 1) - 20} y="36" width="40" height="108" rx="8" />)}
  <g class="f-note" text-anchor="middle">
    {Array.from({ length: 7 }, (_, i) => <text x={X(i)} y="26">{i + 1}</text>)}
    <text x={(X(0) + X(6)) / 2} y="166">both act on qubits 3 and 7: an even overlap</text>
  </g>
  {rows.map(({ y, kind, on, name }) => (
    <g>
      <text class="f-label" x="136" y={y + 5} text-anchor="end">{name}</text>
      {Array.from({ length: 7 }, (_, i) => on.includes(i + 1)
        ? <g>
            <circle class={`f-${kind}`} cx={X(i)} cy={y} r="13" />
            <text class={`f-${kind}-t`} x={X(i)} y={y + 4.5} text-anchor="middle">{kind.toUpperCase()}</text>
          </g>
        : <circle class="f-qubit" cx={X(i)} cy={y} r="3.5" />)}
    </g>
  ))}
</svg>
