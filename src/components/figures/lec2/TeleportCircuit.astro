---
// Teleportation as one circuit. Wires from top to bottom: M (the message), A (Alice's half of the
// Bell pair), B (Bob's half). CNOT M -> A, H on M, measure M (bit m) and A (bit a),
// then Bob applies X if a = 1 and Z if m = 1, in that order.
const yM = 50, yA = 110, yB = 170;
const x0 = 96;
const xC = 150, xH = 205, mx = 250;   // CNOT, Hadamard, left edge of the meters
const xX = 390, xZ = 480, xEnd = 590;
const meters = [[yM, xZ], [yA, xX]];   // wire, x of the gate the bit controls
const boxes = [[xX, 'X'], [xZ, 'Z']] as const;
---
<svg viewBox="0 0 640 220" role="img" aria-label="Teleportation circuit: CNOT from M to A, Hadamard on M, both measured, and the two bits control X and Z gates on the qubit B">
  <g class="f-note">
    <text x="12" y={yM + 4}>M</text>
    <text x="12" y={yA + 4}>A</text>
    <text x="12" y={yB + 4}>B</text>
    <text x={(xC + mx + 36) / 2} y="16" text-anchor="middle">Alice</text>
    <text x={(xX + xZ) / 2} y="208" text-anchor="middle">Bob</text>
    <text x="296" y="76">two classical bits</text>
  </g>

  <text class="f-label" x={x0 - 10} y={yM + 5} text-anchor="end">|ψ⟩</text>
  <path class="f-thin" d={`M${x0 - 8} ${yA} H${x0 - 16} V${yB} H${x0 - 8}`} />
  <text class="f-label" x={x0 - 24} y={(yA + yB) / 2 + 5} text-anchor="end">|Φ⁺⟩</text>

  <line class="f-wire" x1={x0} y1={yM} x2={mx} y2={yM} />
  <line class="f-wire" x1={x0} y1={yA} x2={mx} y2={yA} />
  <line class="f-wire" x1={x0} y1={yB} x2={xEnd} y2={yB} />

  <line class="f-wire" x1={xC} y1={yM} x2={xC} y2={yA + 9} />
  <circle class="f-dot" cx={xC} cy={yM} r="4.5" />
  <circle class="f-target" cx={xC} cy={yA} r="9" />
  <line class="f-wire" x1={xC - 9} y1={yA} x2={xC + 9} y2={yA} />

  <rect class="f-box" x={xH - 14} y={yM - 14} width="28" height="28" rx="4" />
  <text class="f-label" x={xH} y={yM + 5} text-anchor="middle">H</text>

  {meters.map(([y, gx]) => (
    <g>
      <path class="f-classical" d={`M${mx + 36} ${y - 1.5} H${gx + 1.5} V${yB - 18}`} />
      <path class="f-classical" d={`M${mx + 36} ${y + 1.5} H${gx - 1.5} V${yB - 18}`} />
      <rect class="f-box" x={mx} y={y - 14} width="36" height="28" rx="4" />
      <path class="f-wire" fill="none" d={`M${mx + 8} ${y + 7} a10 10 0 0 1 20 0`} />
      <line class="f-wire" x1={mx + 18} y1={y + 7} x2={mx + 27} y2={y - 8} />
    </g>
  ))}
  <text class="f-it" x="330" y={yM - 9} text-anchor="middle">m</text>
  <text class="f-it" x="330" y={yA - 9} text-anchor="middle">a</text>

  {boxes.map(([x, name]) => (
    <g>
      <rect class="f-box" x={x - 18} y={yB - 18} width="36" height="36" rx="4" />
      <text class="f-label" x={x} y={yB + 5} text-anchor="middle">{name}</text>
    </g>
  ))}

  <text class="f-label" x={xEnd + 8} y={yB + 5}>|ψ⟩</text>
</svg>
