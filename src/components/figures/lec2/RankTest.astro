---
// The amplitude matrix M of a product state and of a Bell state, shaded by |amplitude|^2.
const s = 70, y0 = 50;
const half = 0.5, r = Math.SQRT1_2;
const panels = [
  { cx: 130, title: 'product state |+⟩|+⟩', m: [[half, half], [half, half]], det: 'det M = 0' },
  { cx: 390, title: 'Bell state |Φ⁺⟩', m: [[r, 0], [0, r]], det: 'det M = ½' },
];
const show = (a: number) => (a === 0 ? '0' : a === half ? '½' : '1/√2');
---
<svg viewBox="0 0 520 225" role="img" aria-label="The amplitude matrix of a product state has proportional rows; that of a Bell state does not">
  {panels.map(({ cx, title, m, det }) => (
    <g>
      <text class="f-label f-strong" x={cx} y="16" text-anchor="middle">{title}</text>
      {[0, 1].map((j) => (
        <text class="f-note" x={cx - s / 2 + j * s} y="40" text-anchor="middle">B = {j}</text>
      ))}
      {[0, 1].map((i) => (
        <text class="f-note" x={cx - s - 10} y={y0 + i * s + s / 2 + 4} text-anchor="end">A = {i}</text>
      ))}
      {m.map((row, i) => row.map((a, j) => (
        <g>
          <rect class="f-face" x={cx - s + j * s} y={y0 + i * s} width={s} height={s} fill-opacity={(2 * a * a).toFixed(2)} />
          <rect class="f-cell" x={cx - s + j * s} y={y0 + i * s} width={s} height={s} style="fill:none" />
          <text class="f-label" x={cx - s / 2 + j * s} y={y0 + i * s + s / 2 + 5} text-anchor="middle">{show(a)}</text>
        </g>
      )))}
      <text class="f-label" x={cx} y={y0 + 2 * s + 26} text-anchor="middle">{det}</text>
    </g>
  ))}
</svg>
