---
// Superdense coding as a circuit. Top wire: Alice's qubit; bottom wire: Bob's.
// Alice applies X^y then Z^x; Bob applies CNOT (top controls bottom), then H on the top qubit,
// and measures: x on the top wire, y on the bottom one.
const yA = 70, yB = 130;
const x0 = 96;
const gates = [[170, 'X', 'y'], [235, 'Z', 'x']] as const;
const xSend = 300;
const xC = 370, xH = 425, mx = 470;
const outs = [[yA, 'x'], [yB, 'y']] as const;
---
<svg viewBox="0 0 560 200" role="img" aria-label="Superdense coding circuit: Alice applies X to the power y and then Z to the power x to her half of a Bell pair, Bob applies CNOT and Hadamard and measures both qubits">
  <g class="f-note" text-anchor="middle">
    <text x="202" y="20">Alice encodes</text>
    <text x="420" y="20">Bob decodes</text>
    <text x={xSend} y="190">here Alice sends her qubit to Bob</text>
  </g>
  <line class="f-ghost" x1={xSend} y1="30" x2={xSend} y2="172" />

  <path class="f-thin" d={`M${x0 - 8} ${yA} H${x0 - 16} V${yB} H${x0 - 8}`} />
  <text class="f-label" x={x0 - 24} y={(yA + yB) / 2 + 5} text-anchor="end">|β₀₀⟩</text>

  <line class="f-wire" x1={x0} y1={yA} x2={mx} y2={yA} />
  <line class="f-wire" x1={x0} y1={yB} x2={mx} y2={yB} />

  {gates.map(([x, name, power]) => (
    <g>
      <rect class="f-box" x={x - 20} y={yA - 18} width="40" height="36" rx="4" />
      <text class="f-label" x={x} y={yA + 6} text-anchor="middle">{name}<tspan class="sd-sup" dy="-7">{power}</tspan></text>
    </g>
  ))}

  <line class="f-wire" x1={xC} y1={yA} x2={xC} y2={yB + 9} />
  <circle class="f-dot" cx={xC} cy={yA} r="4.5" />
  <circle class="f-target" cx={xC} cy={yB} r="9" />
  <line class="f-wire" x1={xC - 9} y1={yB} x2={xC + 9} y2={yB} />

  <rect class="f-box" x={xH - 14} y={yA - 14} width="28" height="28" rx="4" />
  <text class="f-label" x={xH} y={yA + 5} text-anchor="middle">H</text>

  {outs.map(([y, bit]) => (
    <g>
      <rect class="f-box" x={mx} y={y - 14} width="36" height="28" rx="4" />
      <path class="f-wire" fill="none" d={`M${mx + 8} ${y + 7} a10 10 0 0 1 20 0`} />
      <line class="f-wire" x1={mx + 18} y1={y + 7} x2={mx + 27} y2={y - 8} />
      <text class="f-it" x={mx + 48} y={y + 5}>{bit}</text>
    </g>
  ))}
</svg>

<style>
  .sd-sup { font-size: 11px; font-style: italic; }
</style>
