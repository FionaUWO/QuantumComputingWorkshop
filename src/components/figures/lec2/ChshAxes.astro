---
// The CHSH measurement directions in the x-z plane of the Bloch sphere.
// Q = Z, R = X (Alice); S = (-Z - X)/sqrt2, T = (Z - X)/sqrt2 (Bob).
const cx = 190, cy = 150, R = 95;
const k = Math.SQRT1_2;
// (x, z) components; z points up on the page, x to the right
const tip = (x: number, z: number, r = R - 2) => [cx + r * x, cy - r * z];
const axes = [
  { who: 'alice', v: [0, 1] },
  { who: 'alice', v: [1, 0] },
  { who: 'bob', v: [-k, -k] },
  { who: 'bob', v: [-k, k] },
].map(({ who, v }) => ({ who, p: tip(v[0], v[1]) }));
const f = (n: number) => n.toFixed(1);
// arc of 45 degrees from Q to T (radius 34) and of 135 degrees from R to S (radius 26)
const a1 = tip(0, 1, 34), a2 = tip(-k, k, 34);
const b1 = tip(1, 0, 26), b2 = tip(-k, -k, 26);
---
<svg viewBox="0 0 380 295" role="img" aria-label="The four CHSH measurement axes: Q along z, R along x, and S and T on the diagonals; T is 45 degrees from Q and the other three pairs are 135 degrees apart">
  <defs>
    <marker id="lec2-chsh-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
    <marker id="lec2-chsh-arrow-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto">
      <path class="f-dot" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  <line class="f-hot" x1="12" y1="16" x2="36" y2="16" />
  <text class="f-note" x="44" y="20">Alice</text>
  <line class="chsh-bob" x1="12" y1="36" x2="36" y2="36" />
  <text class="f-note" x="44" y="40">Bob</text>

  <circle class="f-ring" cx={cx} cy={cy} r={R} />
  <line class="f-axis" x1={cx - R} y1={cy} x2={cx + R} y2={cy} />
  <line class="f-axis" x1={cx} y1={cy - R} x2={cx} y2={cy + R} />

  <path class="f-thin" d={`M${f(a1[0])} ${f(a1[1])} A34 34 0 0 0 ${f(a2[0])} ${f(a2[1])}`} />
  <text class="f-note" x="171" y="108" text-anchor="middle">45°</text>
  <path class="f-thin" d={`M${f(b1[0])} ${f(b1[1])} A26 26 0 0 1 ${f(b2[0])} ${f(b2[1])}`} />
  <text class="f-note" x="210" y="198" text-anchor="middle">135°</text>

  {axes.map(({ who, p }) => (
    <line class={who === 'alice' ? 'f-hot' : 'chsh-bob'} x1={cx} y1={cy} x2={f(p[0])} y2={f(p[1])}
      marker-end={who === 'alice' ? 'url(#lec2-chsh-arrow-a)' : 'url(#lec2-chsh-arrow-b)'} />
  ))}
  <circle class="f-dot" cx={cx} cy={cy} r="3.5" />

  <text class="f-label" x={cx} y={cy - R - 12} text-anchor="middle">Q = Z</text>
  <text class="f-label" x={cx + R + 10} y={cy + 5}>R = X</text>
  <text class="f-label" x={f(cx - R * k - 9)} y={f(cy + R * k + 17)} text-anchor="end">S</text>
  <text class="f-label" x={f(cx - R * k - 9)} y={f(cy - R * k - 5)} text-anchor="end">T</text>

  <text class="f-note" x={cx} y="284" text-anchor="middle">T is 45° from Q; the other three pairs are 135° apart</text>
</svg>

<style>
  .chsh-bob { stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
</style>
