---
// H on A, then CNOT from A to B, acting on |00>. The state of the pair is written under each
// dashed line. With motion allowed, a highlight steps through the three stages.
const yA = 50, yB = 100;
const x0 = 70, x1 = 445;
const xH = 160, xC = 295;
const stages = [
  { x: 100, state: '|00⟩' },
  { x: 225, state: '(|00⟩ + |10⟩)/√2' },
  { x: 365, state: '(|00⟩ + |11⟩)/√2' },
];
---
<svg viewBox="0 0 520 175" role="img" aria-label="Circuit preparing a Bell pair from two qubits in the state zero: a Hadamard gate on A, then a CNOT from A to B">
  <text class="f-note" x="14" y={yA + 4}>A</text>
  <text class="f-note" x="14" y={yB + 4}>B</text>
  <text class="f-label" x={x0 - 10} y={yA + 5} text-anchor="end">|0⟩</text>
  <text class="f-label" x={x0 - 10} y={yB + 5} text-anchor="end">|0⟩</text>

  {stages.map(({ x, state }, i) => (
    <g>
      <rect class="bc-glow" x={x - 66} y="131" width="132" height="28" rx="6" style={`animation-delay:${i * 3}s`} />
      <line class="f-ghost" x1={x} y1="24" x2={x} y2="126" />
      <text class="f-label" x={x} y="150" text-anchor="middle">{state}</text>
    </g>
  ))}

  <line class="f-wire" x1={x0} y1={yA} x2={x1} y2={yA} />
  <line class="f-wire" x1={x0} y1={yB} x2={x1} y2={yB} />

  <rect class="f-box" x={xH - 14} y={yA - 14} width="28" height="28" rx="4" />
  <text class="f-label" x={xH} y={yA + 5} text-anchor="middle">H</text>

  <line class="f-wire" x1={xC} y1={yA} x2={xC} y2={yB + 9} />
  <circle class="f-dot" cx={xC} cy={yA} r="4.5" />
  <circle class="f-target" cx={xC} cy={yB} r="9" />
  <line class="f-wire" x1={xC - 9} y1={yB} x2={xC + 9} y2={yB} />

  <path class="f-thin" d={`M${x1 + 4} ${yA - 6} h6 V${yB + 6} h-6`} />
  <text class="f-label" x={x1 + 18} y={(yA + yB) / 2 + 5}>|Φ⁺⟩</text>
</svg>

<style>
  .bc-glow { fill: var(--lavender); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .bc-glow { animation: lec2-bell-step 9s linear infinite; }
  }
  @keyframes lec2-bell-step {
    0% { opacity: 0; }
    3% { opacity: 1; }
    30% { opacity: 1; }
    33%, 100% { opacity: 0; }
  }
</style>
