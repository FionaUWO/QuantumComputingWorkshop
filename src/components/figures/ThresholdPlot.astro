---
// Logical against physical error rate for distances 3, 5 and 7, on logarithmic axes,
// from p_L = A (p / p_th)^((d+1)/2) with A = 0.1 and p_th = 0.01. The lines cross at the threshold.
const lx0 = -3, lx1 = -1.6, ly0 = -5.5, ly1 = -0.2;
const px = (l: number) => 78 + ((l - lx0) / (lx1 - lx0)) * 320;
const py = (v: number) => 258 - ((v - ly0) / (ly1 - ly0)) * 230;
const pl = (d: number, l: number) => -1 + ((d + 1) / 2) * (l + 2);
// each line stops at the right edge or at the top of the frame, whichever comes first
const end = (d: number) => Math.min(lx1, -2 + (ly1 + 1) / ((d + 1) / 2));
const ds = [3, 5, 7];
const xt = [[-3, '10⁻³'], [-2, '10⁻²']] as const;
const yt = [[-5, '10⁻⁵'], [-3, '10⁻³'], [-1, '10⁻¹']] as const;
---
<svg viewBox="0 0 430 312" role="img" aria-label="Below the threshold a larger code distance gives a lower logical error rate">
  <line class="f-axis" x1={px(lx0)} y1={py(ly0)} x2={px(lx1)} y2={py(ly0)} />
  <line class="f-axis" x1={px(lx0)} y1={py(ly0)} x2={px(lx0)} y2={py(ly1)} />
  <g class="f-note">
    {xt.map(([l, s]) => (
      <g>
        <line class="f-axis" x1={px(l)} y1={py(ly0)} x2={px(l)} y2={py(ly0) + 5} />
        <text x={px(l)} y={py(ly0) + 20} text-anchor="middle">{s}</text>
      </g>
    ))}
    {yt.map(([v, s]) => (
      <g>
        <line class="f-axis" x1={px(lx0) - 5} y1={py(v)} x2={px(lx0)} y2={py(v)} />
        <text x={px(lx0) - 10} y={py(v) + 4} text-anchor="end">{s}</text>
      </g>
    ))}
    <text x={px((lx0 + lx1) / 2)} y="304" text-anchor="middle">physical error rate p</text>
    <text transform={`translate(20 ${py((ly0 + ly1) / 2)}) rotate(-90)`} text-anchor="middle">logical error rate</text>
    <text x={px(-2)} y={py(ly1) - 8} text-anchor="middle">threshold</text>
  </g>

  <line class="f-ghost" x1={px(-2)} y1={py(ly0)} x2={px(-2)} y2={py(ly1)} />
  {ds.map((d) => (
    <g>
      <line class="f-curve" x1={px(lx0)} y1={py(pl(d, lx0))} x2={px(end(d))} y2={py(pl(d, end(d)))} />
      <text class="f-label" text-anchor="middle"
        transform={`translate(${px(-2.72)} ${py(pl(d, -2.72))}) rotate(${-Math.atan(((d + 1) / 2) * (230 / (ly1 - ly0)) / (320 / (lx1 - lx0))) * 180 / Math.PI})`}
        y="-8">d = {d}</text>
    </g>
  ))}
  <circle class="f-syn" cx={px(-2)} cy={py(-1)} r="6" />
</svg>
