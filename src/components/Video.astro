---
// The narrated video of a section, shown above its notes.
// `src`, `poster` and `captions` are site-relative paths under public/, for example
// "assets/video/L1_1.mp4". `captions` is a WebVTT file: the viewer switches the subtitles on and
// off with the player's own captions button, so they are never part of the picture.
import { url } from '../lib/url';

interface Props {
  src: string;
  poster?: string;
  captions?: string;
  title: string;
}
const { src, poster, captions, title } = Astro.props;
---
<figure class="lesson-video">
  <video controls preload="metadata" playsinline poster={poster ? url(poster) : undefined} aria-label={title}>
    <source src={url(src)} type="video/mp4">
    {captions && <track kind="subtitles" srclang="en" label="English" src={url(captions)} default>}
    <a href={url(src)}>Download the video</a>
  </video>
  <figcaption>{title}</figcaption>
</figure>
